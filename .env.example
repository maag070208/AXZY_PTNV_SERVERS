# Copia este archivo a `.env` y ajusta los valores si quieres.
# En producción cambia SIEMPRE POSTGRES_PASSWORD y JWT_SECRET.

POSTGRES_PASSWORD=cartas_dev_pwd
JWT_SECRET=cambia_este_secreto_en_produccion
ABLY_API_KEY=

# URL a la que apunta el FRONTEND para llamar al API.
# - Deja `/api/v1` para que nginx enrute al API internamente (recomendado, sirve con cualquier IP).
# - O pon una URL absoluta, ej: http://192.168.1.176:4001/api/v1
WEB_API_URL=/api/v1

# Relojes checadores (web: Configuración → Relojes checadores). Usuario y
# contraseña de los relojes, los mismos para todos; el sistema solo les lee.
# Si la contraseña lleva $, # o espacios, ponla entre comillas simples: 'así'.
CHECADOR_USER=
CHECADOR_PASS=

# Zona horaria de los reportes de entradas/salidas. El hotel y sus relojes
# están en hora del Pacífico. Vacía = America/Mexico_City.
ACCESS_REPORT_TIMEZONE=America/Tijuana

# Archivos en S3 (evidencias de tickets, fotos y documentos del personal).
# Sin estos valores las subidas fallan; lo demás funciona.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-2
